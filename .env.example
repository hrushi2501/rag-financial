# Copy this file to .env. Never commit real credentials.

# Current application: required for vector indexing and retrieval.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=financial-rag
PINECONE_ENVIRONMENT=us-east-1

# Current application: optional for retrieval, required for generated answers.
GEMINI_API_KEY=

# Current Flask runtime.
PORT=5000
FLASK_DEBUG=0
ALLOWED_ORIGINS=http://localhost:3000
AUTH_MODE=disabled
DEV_USER_ID=local-user
DEV_TENANT_ID=local-tenant
ENABLE_ADMIN_FLUSH=false
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_FILE_SIZE=104857600
MAX_DOCUMENT_PAGES=2000
MAX_ARCHIVE_UNCOMPRESSED_SIZE=536870912
EMBEDDING_MODEL=ProsusAI/finbert

# Container/runtime cache location.
HF_HOME=/var/cache/huggingface

# Local/Docker asynchronous ingestion adapter. Production replaces the API
# upload hop with a short-lived signed Supabase Storage upload.
ASYNC_INGESTION_ENABLED=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_ASYNC_INGESTION=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used when AUTH_MODE=supabase. Asymmetric JWKS verification is preferred.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Production persistence/storage integration. Browser/backend auth consumes the
# public URL/key; Storage and Postgres repository adapters remain roadmap work.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=financial-documents
